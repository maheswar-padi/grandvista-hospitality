<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.grandvista</groupId>
        <artifactId>grandvista-hospitality</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>coverage</artifactId>
    <packaging>pom</packaging>
    <name>coverage</name>
    <description>Aggregated JaCoCo report of all modules: coverage/target/site/jacoco-aggregate/index.html</description>

    <dependencies>
        <dependency><groupId>com.grandvista</groupId><artifactId>platform-commons</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.grandvista</groupId><artifactId>discovery-server</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.grandvista</groupId><artifactId>api-gateway</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.grandvista</groupId><artifactId>auth-service</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.grandvista</groupId><artifactId>room-service</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.grandvista</groupId><artifactId>booking-service</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.grandvista</groupId><artifactId>payment-service</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.grandvista</groupId><artifactId>notification-service</artifactId><version>${project.version}</version></dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
