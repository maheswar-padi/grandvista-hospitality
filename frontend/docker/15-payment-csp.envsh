#!/bin/sh
# Sourced by the nginx entrypoint before templates are rendered. Widens the Content-Security-Policy for
# Razorpay Checkout only when the platform runs with GV_PAYMENT_PROVIDER=razorpay; otherwise scripts, frames
# and connections stay same-origin.
if [ "${GV_PAYMENT_PROVIDER:-simulated}" = "razorpay" ]; then
  export CSP_SCRIPT_EXTRA=" https://checkout.razorpay.com"
  export CSP_FRAME_EXTRA=" https://api.razorpay.com https://checkout.razorpay.com"
  export CSP_CONNECT_EXTRA=" https://api.razorpay.com https://lumberjack.razorpay.com"
  export CSP_IMG_EXTRA=" https://cdn.razorpay.com"
else
  export CSP_SCRIPT_EXTRA=""
  export CSP_FRAME_EXTRA=""
  export CSP_CONNECT_EXTRA=""
  export CSP_IMG_EXTRA=""
fi
