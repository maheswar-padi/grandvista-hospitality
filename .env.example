# Copy to .env (or run ./scripts/init-env.sh, which generates strong random values for you).
# .env is git-ignored. NEVER commit real secrets.

# --- PostgreSQL: one server per service (database-per-service). The admin user only initialises each server;
# each service connects with its own non-superuser owner role. Host ports are bound to 127.0.0.1. ---
POSTGRES_ADMIN_USER=grandvista_admin
POSTGRES_ADMIN_PASSWORD=change-me
AUTH_DB_PASSWORD=change-me
ROOM_DB_PASSWORD=change-me
BOOKING_DB_PASSWORD=change-me
PAYMENT_DB_PASSWORD=change-me
NOTIFICATION_DB_PASSWORD=change-me
AUTH_DB_HOST_PORT=5433
ROOM_DB_HOST_PORT=5434
BOOKING_DB_HOST_PORT=5435
PAYMENT_DB_HOST_PORT=5436
NOTIFICATION_DB_HOST_PORT=5437

# --- RabbitMQ (event bus). Management UI: http://localhost:15672 (loopback only) ---
RABBITMQ_USERNAME=grandvista
RABBITMQ_PASSWORD=change-me

# --- Service discovery (Eureka dashboard + client credentials; use URL-safe characters) ---
EUREKA_USERNAME=eureka
EUREKA_PASSWORD=change-me

# --- Service-to-service client credentials (>= 32 characters) ---
BOOKING_SERVICE_CLIENT_SECRET=change-me-to-a-32-plus-character-secret
PAYMENT_SERVICE_CLIENT_SECRET=change-me-to-a-32-plus-character-secret

# --- Payment provider webhook HMAC secret (>= 32 characters) ---
PAYMENT_WEBHOOK_SECRET=change-me-to-a-32-plus-character-secret

# --- Payment provider: "simulated" (default, no money moves) or "razorpay" (Razorpay TEST MODE).
# For razorpay, create a free Razorpay account, switch the dashboard to Test Mode and copy:
#   Settings → API Keys → Generate Test Key  → RAZORPAY_KEY_ID (rzp_test_…) and RAZORPAY_KEY_SECRET
#   Settings → Webhooks → Add (URL https://<public-host>/api/v1/payments/webhooks/razorpay,
#   events payment.captured, payment.failed, order.paid) → the secret you choose → RAZORPAY_WEBHOOK_SECRET
# Live keys (rzp_live_…) are refused at start-up.
GV_PAYMENT_PROVIDER=simulated
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- First administrator (created only if no administrator exists; password >= 12 chars) ---
GV_BOOTSTRAP_ADMIN_EMAIL=admin@grandvista.local
GV_BOOTSTRAP_ADMIN_PASSWORD=change-me-please

# --- Demo accounts (created only when GV_DEMO_SEED_ENABLED=true and the account does not exist; >= 10 chars,
# letter + digit) ---
GV_DEMO_CUSTOMER_EMAIL=guest@grandvista.local
GV_DEMO_CUSTOMER_PASSWORD=change-me-guest-1
GV_DEMO_STAFF_EMAIL=staff@grandvista.local
GV_DEMO_STAFF_PASSWORD=change-me-staff-1

# --- Behaviour ---
GV_HOTEL_ZONE=Asia/Kolkata
GV_DEMO_SEED_ENABLED=true
GV_HOLD_TTL=15m
API_DOCS_ENABLED=true
# Keep true. Browsers treat http://localhost as secure, so Secure cookies work locally.
GV_COOKIE_SECURE=true
GV_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Per-client-IP limits at the gateway (requests per minute). Raise temporarily for load tests.
GV_API_RATE_LIMIT=300
GV_AUTH_RATE_LIMIT=10

# --- Published ports ---
GATEWAY_HOST_PORT=8080
FRONTEND_HOST_PORT=3000
